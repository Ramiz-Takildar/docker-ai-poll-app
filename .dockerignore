# .dockerignore file
# Specifies files and directories to exclude from Docker build context
# This reduces the build context size and speeds up the build process

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.env.local

# Git files
.git
.gitignore
.gitattributes

# Documentation and markdown files
*.md
docs/
README.md

# Test files
tests/
test_*.py
*_test.py

# Other files
.pytest_cache/
.coverage
*.log
.env.example

# Screenshot directories
screenshots/
